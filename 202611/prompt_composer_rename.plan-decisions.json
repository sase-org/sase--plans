{
  "schema": 1,
  "definitions": [
    {
      "id": "page_path",
      "kind": "choice",
      "ask": "Should the reference page also move from reference/tui/prompt-input.md to reference/tui/prompt-composer.md?",
      "why": "The retitle carries the rename; moving the page churns inbound links for no reader benefit",
      "choices": [
        {
          "key": "keep",
          "label": "Keep the URL; retitle the page, its H1, and its nav label only"
        },
        {
          "key": "move",
          "label": "Move the page with tools/docs_move and leave a redirect from the old URL"
        }
      ],
      "default": "keep",
      "effective_default": "keep",
      "requested_verified": false
    },
    {
      "id": "property_panel_name",
      "kind": "choice",
      "ask": "Should the new glossary entry call the FrontmatterPanel the \"property panel\"?",
      "why": "The research's pick; the user, empty state, and property picker modals all say \"property\"",
      "choices": [
        {
          "key": "property",
          "label": "Entry says \"property panel\" and notes the UI and docs call it the frontmatter panel"
        },
        {
          "key": "frontmatter",
          "label": "Entry says \"frontmatter panel\", matching the border title and the docs"
        }
      ],
      "default": "property",
      "effective_default": "property",
      "requested_verified": false
    },
    {
